1" parent="1" source="n19" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n20" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n21" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n55" value="continue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=0;exitY=1;entryX=1;entryY=1;" edge="1" parent="1" source="n24" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n56" value="KeyboardInterrupt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n10" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n57" value="범례&lt;br&gt;• 초록 타원 : 시작/종료&lt;br&gt;• 파랑 사각 : 일반 처리&lt;br&gt;• 주황 서브프로세스 : 로봇 모션 서브루틴 (→ 02 페이지에서 상세)&lt;br&gt;• 보라 사각 : /coffee_system/status 상태 발행 지점&lt;br&gt;• 빨강 : 예외 / 오류 경로&lt;br&gt;&lt;br&gt;모든 모션 서브루틴은 run_protected_stage() 로 감싸져&lt;br&gt;GripFailureError / GripperSignalLostError 발생 시&lt;br&gt;해당 단계를 처음부터 재실행한다 (02 페이지 참조)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#b5a642;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10" vertex="1" parent="1"><mxGeometry x="1060" y="400" width="400" height="220" as="geometry"/></mxCell><mxCell id="n58" value="교시 좌표 (System.drvar 원본)&lt;br&gt;System_spoon_j/l · System_grinder_j/l · System_handle_j/l&lt;br&gt;System_bottle_j_1/j_2/l/l2 · System_drip_j/l · System_home&lt;br&gt;System_pot_grip · Pour_start_joint&lt;br&gt;System_fitter_j · System_filtter_l/l2 · System_mug_j/l · System_final_l&lt;br&gt;&lt;br&gt;→ 비전/외부센서 없이 전량 고정 교시 좌표 기반" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#b5a642;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10" vertex="1" parent="1"><mxGeometry x="120" y="1500" width="380" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="02_FlowChart_그립감시_예외복구" id="02_FlowChart_그립감시_예외복구"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="02. 그립 감시 · 예외 복구 FlowChart" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="n2" value="coffee_system.py — run_protected_stage() / GripMonitor 워치독 / guarded_motion()" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1100" height="22" as="geometry"/></mxCell><mxCell id="n3" value="run_protected_stage(stage_id, action)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="520" y="120" width="340" height="50" as="geometry"/></mxCell><mxCell id="n4" value="stage_name / screen / progress 조회&lt;br&gt;retry_count = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="520" y="210" width="340" height="50" as="geometry"/></mxCell><mxCell id="n5" value="[재시도 루프 진입]  while rclpy.ok()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="520" y="300" width="340" height="45" as="geometry"/></mxCell><mxCell id="n6" value="retry_count &amp;gt; 0 → STAGE_RESTARTED 발행&lt;br&gt;&apos;기억한 단계를 처음부터 다시 실행합니다&apos;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1"><mxGeometry x="520" y="385" width="340" height="55" as="geometry"/></mxCell><mxCell id="n7" value="grip_monitor.wait_until_online(2.0s)&lt;br&gt;신호 정상?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1"><mxGeometry x="490" y="480" width="400" height="85" as="geometry"/></mxCell><mxCell id="n8" value="grip_monitor.begin_stage(stage_id, stage_name)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="520" y="605" width="340" height="45" as="geometry"/></mxCell><mxCell id="n9" value="raise_if_signal_lost()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="520" y="690" width="340" height="40" as="geometry"/></mxCell><mxCell id="n10" value="result = action()&lt;br&gt;(bean_drop / grinder / dripper_in / spiral_pour / final_drip)&lt;br&gt;※ 내부 모션은 guarded_motion 래핑 — 호출 전후로 신호 재검사" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="520" y="770" width="340" height="75" as="geometry"/></mxCell><mxCell id="n11" value="raise_if_signal_lost()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="520" y="885" width="340" height="40" as="geometry"/></mxCell><mxCell id="n12" value="예외 종류?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1"><mxGeometry x="560" y="965" width="260" height="80" as="geometry"/></mxCell><mxCell id="n13" value="grip_monitor.end_stage()&lt;br&gt;return result" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="520" y="1085" width="340" height="55" as="geometry"/></mxCell><mxCell id="n14" value="force_signal_loss(reason)&lt;br&gt;signal_health_reason() 기록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1"><mxGeometry x="1050" y="480" width="300" height="55" as="geometry"/></mxCell><mxCell id="n15" value="recover_gripper_signal(error)&lt;br&gt;· 장비오류 화면 발행 (equipment_error=True)&lt;br&gt;· 신호 복구까지 대기 · 카운트다운 발행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1"><mxGeometry x="1050" y="585" width="300" height="75" as="geometry"/></mxCell><mxCell id="n16" value="recover_grip_failure(error)&lt;br&gt;· GRIP_FAILURE 화면 발행&lt;br&gt;· 그리퍼 재개방 · 작업물 재배치 안내 대기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1"><mxGeometry x="1050" y="700" width="300" height="75" as="geometry"/></mxCell><mxCell id="n17" value="restore_default_context_after_recovery()&lt;br&gt;tool/tcp · velj/accj · velx/accx 재설정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1050" y="815" width="300" height="60" as="geometry"/></mxCell><mxCell id="n18" value="retry_count += 1&lt;br&gt;continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1050" y="915" width="300" height="50" as="geometry"/></mxCell><mxCell id="n19" value="end_stage() → raise&lt;br&gt;→ 상위 main() ERROR 화면 (screen=9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1"><mxGeometry x="1050" y="1015" width="300" height="60" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="No (타임아웃)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="루프 선두로 복귀" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n18" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="예외 없음" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="GripFailureError" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="GripperSignalLostError" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=1;exitY=0;entryX=0;entryY=1;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="그 외 BaseException" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=1;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n12" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="GripMonitor 워치독  (create_timer 0.05s = 20 Hz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="200" width="380" height="40" as="geometry"/></mxCell><mxCell id="n40" value="구독 입력 3종&lt;br&gt;  /onrobot/grip_detected      std_msgs/Bool&lt;br&gt;  /onrobot_joint_states       sensor_msgs/JointState&lt;br&gt;  /OnRobotRGInput             onrobot_rg_msgs/OnRobotRGInput&lt;br&gt;&lt;br&gt;판정&lt;br&gt;  · 각 신호 stale 여부 (타임스탬프 신선도)&lt;br&gt;  · gSTA 안전 비트 → _rg2_gsta_safety_names()&lt;br&gt;  · verify_grip() : 닫기 명령 후 위치/전류 확인&lt;br&gt;&lt;br&gt;이상 감지 시&lt;br&gt;  → request_motion_stop(reason)&lt;br&gt;  → motion/move_stop 서비스 call_async (dsr_msgs2/MoveStop)&lt;br&gt;  → GripperSignalLostError / GripFailureError 예외 발생" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#b5a642;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10" vertex="1" parent="1"><mxGeometry x="60" y="250" width="380" height="300" as="geometry"/></mxCell><mxCell id="n41" value="신호 상태 제공" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6A1B9A;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n39" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="guarded_motion(fn) 데코레이터&lt;br&gt;  raise_if_signal_lost()   ← 호출 전&lt;br&gt;  result = fn(*args)&lt;br&gt;  raise_if_signal_lost()   ← 호출 후 (예외 시에도 먼저 검사)&lt;br&gt;&lt;br&gt;목적 : MoveStop 으로 인해 모션 서비스가 일반 예외를 던지더라도&lt;br&gt;장비오류 복구 경로로 정확히 분기시키기 위함." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#b5a642;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10" vertex="1" parent="1"><mxGeometry x="60" y="600" width="380" height="170" as="geometry"/></mxCell><mxCell id="n43" value="재시도 정책 요약&lt;br&gt;  · 재시도 횟수 상한 없음 (rclpy.ok() 동안 무한 재시도)&lt;br&gt;  · 재시도 단위 = 단계 전체 재실행 (부분 재개 아님)&lt;br&gt;  · 복구 후 반드시 tool/tcp/속도 컨텍스트 재설정&lt;br&gt;  · GripFailure / SignalLost 외의 예외는 재시도하지 않고 상위로 전파" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#b5a642;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10" vertex="1" parent="1"><mxGeometry x="60" y="820" width="380" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="03_NodeDiagram_토픽_서비스" id="03_NodeDiagram_토픽_서비스"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="03. Node Diagram — 토픽 / 서비스 통신" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="n2" value="rokey 패키지 (ament_python) + doosan-robot2 / onrobot-ros2 외부 패키지 · 네임스페이스 dsr01" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1100" height="22" as="geometry"/></mxCell><mxCell id="n3" value="① 사용자 / 외부" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;s