1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="264" as="sourcePoint"/><mxPoint x="1400" y="264" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n21" value="✕ 토픽 발행 중단 — 그리퍼 통신 두절 / 컴퓨트박스 오류" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="314" as="sourcePoint"/><mxPoint x="780" y="314" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="  loop  워치독 20Hz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontStyle=2;fontColor=#9673a6" vertex="1" parent="1"><mxGeometry x="620" y="334" width="860" height="210" as="geometry"/></mxCell><mxCell id="n23" value="_watchdog() → _signal_health_locked(now)&lt;br&gt;status / bit / joint 각 표본 age &amp;gt; GRIP_SIGNAL_TIMEOUT_SEC(1.0s) ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="790" y="348" width="340" height="42" as="geometry"/></mxCell><mxCell id="n24" value="_signal_lost = True · _loss_reason 기록&lt;br&gt;gSTA 안전비트 → _rg2_gsta_safety_names()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6" vertex="1" parent="1"><mxGeometry x="790" y="408" width="340" height="42" as="geometry"/></mxCell><mxCell id="n25" value="request_motion_stop() → motion/move_stop.call_async()&lt;br&gt;MoveStop.Request(stop_mode=GRIP_SIGNAL_STOP_MODE)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="499" as="sourcePoint"/><mxPoint x="1400" y="499" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n26" value="notify_signal_loss_immediately() → publish:&lt;br&gt;phase=GRIPPER_SIGNAL_ERROR, screen=11, recovery_state=WAIT_MOTION_STOP&lt;br&gt;(워치독 스레드에서 즉시 latch)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="555" as="sourcePoint"/><mxPoint x="1710" y="555" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n27" value="화면 11 (EQUIPMENT ERROR) 표시" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1710" y="617" as="sourcePoint"/><mxPoint x="2020" y="617" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n28" value="MoveStop response(success) → _motion_stop_done()" style="html=1;endArrow=open;endFill=0;endSize=8;dashed=1;rounded=0;strokeColor=#666666;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="667" as="sourcePoint"/><mxPoint x="780" y="667" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n29" value="진행 중이던 movesx 예외 반환 / 즉시 정지" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="717" as="sourcePoint"/><mxPoint x="470" y="717" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n30" value="guarded_motion 래퍼: raise_if_signal_lost()&lt;br&gt;→ GripperSignalLostError 로 승격 (일반 로봇오류 화면으로 새지 않게)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6" vertex="1" parent="1"><mxGeometry x="480" y="742" width="340" height="42" as="geometry"/></mxCell><mxCell id="n31" value="end_stage() → recover_gripper_signal(error) 진입" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="825" as="sourcePoint"/><mxPoint x="780" y="825" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n32" value="  loop  ① 정지 확인 — wait_for_stop_result(0.1s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontStyle=2;fontColor=#9673a6" vertex="1" parent="1"><mxGeometry x="60" y="857" width="1420" height="240" as="geometry"/></mxCell><mxCell id="n33" value="stop_result is False → retry_motion_stop() (1초 쿨다운)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="480" y="874" width="340" height="32" as="geometry"/></mxCell><mxCell id="n34" value="재정지 요청 (필요 시)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#B85450;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="936" as="sourcePoint"/><mxPoint x="1400" y="936" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n35" value="publish 0.5s 주기: recovery_state=WAIT_MOTION_STOP" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="980" as="sourcePoint"/><mxPoint x="1710" y="980" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n36" value="정지가 확인될 때까지 재시작 승인을 받지 않는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="480" y="1008" width="340" height="32" as="geometry"/></mxCell><mxCell id="n37" value="  loop  ② 신호 복구 대기" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontStyle=2;fontColor=#9673a6" vertex="1" parent="1"><mxGeometry x="60" y="1066" width="1420" height="200" as="geometry"/></mxCell><mxCell id="n38" value="publish 0.5s 주기: recovery_state=WAIT_GRIPPER_SIGNAL&lt;br&gt;message = signal_health_reason()" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1099" as="sourcePoint"/><mxPoint x="1710" y="1099" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n39" value="그리퍼 연결 복구 → 3개 토픽 발행 재개" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="1155" as="sourcePoint"/><mxPoint x="780" y="1155" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n40" value="publish 0.2s 주기: recovery_state=SIGNAL_STABILIZING&lt;br&gt;GRIP_SIGNAL_RECOVERY_STABLE_SEC = 0.5s 연속 정상 필요" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1201" as="sourcePoint"/><mxPoint x="1710" y="1201" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n41" value="  loop  ③ 재시작 승인 — 중간에 신호 재악화 시 ②로 되돌아감" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=10;fontStyle=2;fontColor=#9673a6" vertex="1" parent="1"><mxGeometry x="60" y="1249" width="1420" height="300" as="geometry"/></mxCell><mxCell id="n42" value="publish: recovery_state=WAIT_RESTART_CONFIRMATION&lt;br&gt;waiting_physical_button=True" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1282" as="sourcePoint"/><mxPoint x="1710" y="1282" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n43" value="DI 13 대기 — cancel_if=lambda: not signal_online()" style="html=1;endArrow=open;endFill=0;endSize=8;dashed=1;rounded=0;strokeColor=#666666;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1338" as="sourcePoint"/><mxPoint x="160" y="1338" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n44" value="DI 13 ON" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="1384" as="sourcePoint"/><mxPoint x="470" y="1384" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n45" value="publish 0.1s 주기: recovery_state=RESTART_COUNTDOWN&lt;br&gt;recovery_countdown_sec = 3.0 → 0.0" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1428" as="sourcePoint"/><mxPoint x="1710" y="1428" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n46" value="카운트다운 중 signal_online() False → ButtonWaitCancelled /&lt;br&gt;countdown_cancelled → online_since 리셋 후 ②로 복귀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6" vertex="1" parent="1"><mxGeometry x="480" y="1463" width="340" height="42" as="geometry"/></mxCell><mxCell id="n47" value="clear_signal_loss_if_healthy()" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1560" as="sourcePoint"/><mxPoint x="780" y="1560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n48" value="publish: phase=STAGE_RESTARTING, screen=11, recovery_state=RESTARTING&lt;br&gt;set_equipment_error_active(False)" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1604" as="sourcePoint"/><mxPoint x="1710" y="1604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n49" value="restore_default_context_after_recovery() → retry_count += 1 → continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="480" y="1644" width="340" height="32" as="geometry"/></mxCell><mxCell id="n50" value="publish: phase=STAGE_RESTARTED, screen=6, progress=75" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1706" as="sourcePoint"/><mxPoint x="1710" y="1706" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n51" value="begin_stage(&apos;spiral_pour&apos;) — 재시도 1회차" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;fontSize=10;verticalAlign=bottom;align=center;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1752" as="sourcePoint"/><mxPoint x="780" y="1752" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n52" value="설계 의도 / 확인된 특성&lt;br&gt;  · 워치독 스레드가 화면 11을 &apos;먼저&apos; latch 한다. 공정 스레드가 동기 모션에&lt;br&gt;    묶여 있어도 UI 반응이 지연되지 않게 하려는 구조.&lt;br&gt;  · 정지 확인(①) → 신호 정상(②) → 사람 승인(③) 3단 게이트.&lt;br&gt;    어느 단계에서든 신호가 다시 나빠지면 ②로 되돌아간다.&lt;br&gt;  · move_stop 서비스가 not ready 이면 _stop_success=False 로 기록만 하고&lt;br&gt;    루프에서 retry_motion_stop() 으로 재시도한다 (1초 쿨다운).&lt;br&gt;&lt;br&gt;리스크&lt;br&gt;  · ①~③ 어디에도 전체 타임아웃이 없다. 신호가 영구 두절되면 무한 대기.&lt;br&gt;  · 재시작 승인 버튼(DI 13)이 &apos;새 주문&apos; 버튼과 동일 번호라 화면 8/11 문맥&lt;br&gt;    구분에 전적으로 의존한다.&lt;br&gt;  · 이 시퀀스 동안 /coffee_system/status 를 워치독 스레드와 공정 스레드가&lt;br&gt;    동시에 발행한다 (StatusReporter 내부 RLock 으로만 보호)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#b5a642;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10" vertex="1" parent="1"><mxGeometry x="60" y="1840" width="800" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="06_WebUI_화면전이도" id="06_WebUI_화면전이도"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="06. 웹 UI 화면 전이도 — screen 1~11 ↔ phase 매핑" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="n2" value="coffee_system.py status.publish(screen=, phase=, progress=)  →  /coffee_system/status  →  web_ui.py apply(s) → show(n)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1100" height="22" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;screen 1 — STEP 01 · PHYSICAL SELECTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;TEST_READY          progress 0&lt;br&gt;BEAN_SELECTED       progress 3&lt;br&gt;TEST_DONE           progress 100&lt;br&gt;&lt;br&gt;busy=False / waiting_physical_button=True&lt;br&gt;DI 13~16 로 전체 공정 시작&lt;br&gt;gripper_open · gripper_close 테스트도 이 화면" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="60" y="170" width="310" height="210" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;screen 2 — STEP 02 · BEAN LOADING&lt;/b&gt;&lt;br&gt;&lt;br&gt;BEAN_LOADING        progress 10&lt;br&gt;TEST_BEAN_DROP      progress 10&lt;br&gt;&lt;br&gt;스푼 파지 → 원두 계량 → 호퍼 투입&lt;br&gt;(stage_recovery_ui[&apos;bean_drop&apos;] = (2, 10))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="410" y="170" width="310" height="210" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;screen 3 — STEP 03 · GRIND SIZE SELECTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;GRIND_SELECT        progress 34&lt;br&gt;GRIND_SELECTED      progress 37&lt;br&gt;GRIND_DEFAULTED     progress 37&lt;br&gt;&lt;br&gt;DI13=3 · DI14=5 · DI15=7 · DI16=10 회전&lt;br&gt;SELECTION_TIMEOUT_SEC = 15s&lt;br&gt;→ 무입력 시 DI13 자동 선택(GRIND_DEFAULTED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="760" y="170" width="310" height="210" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;screen 4 — STEP 04 · GRINDING&lt;/b&gt;&lt;br&gt;&lt;br&gt;GRINDER_MOVE        progress 42&lt;br&gt;TEST_GRINDER        progress 42&lt;br&gt;GRINDING            progress 가변&lt;br&gt;&lt;br&gt;grind_current_turns / grind_turns 실시간 갱신&lt;br&gt;amovec + check_motion 기반 회전수 진행률&lt;br&gt;(stage_recovery_ui[&apos;grinder&apos;] = (4, 42))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="1110" y="170" width="310" height="210" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;screen 5 — STEP 05 · FILTER LOADING&lt;/b&gt;&lt;br&gt;&lt;br&gt;FILTER_LOADING      progress 68&lt;br&gt;TEST_DRIPPER_IN     progress 68&lt;br&gt;WAIT_EXTERNAL_FORCE progress 70&lt;br&gt;FILTER_FINISHING    progress 74&lt;br&gt;&lt;br&gt;force_delta_n / force_threshold_n(4.0N) 표시&lt;br&gt;외력 미감지 시 10초 후 자동 진행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="1110" y="430" width="310" height="210" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;screen 6 — STEP 06 · SPIRAL POUR&lt;/b&gt;&lt;br&gt;&lt;br&gt;SPIRAL_START 75 · SPIRAL_PICKUP · SPIRAL_PREPARING&lt;br&gt;SPIRAL_POURING · SPIRAL_CENTER_RETURN&lt;br&gt;SPIRAL_RETURNING · SPIRAL_RELEASING · SPIRAL_DONE&lt;br&gt;TEST_SPIRAL_POUR    progress 75&lt;br&gt;&lt;br&gt;progress = clamp(75 + spiral_progress × 0.13, 75, 88)&lt;br&gt;spiral_stage / spiral_progress 별도 표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="760" y="430" width="310" height="210" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;screen 7 — STEP 07 · FINAL DRIP&lt;/b&gt;&lt;br&gt;&lt;br&gt;FINAL_DRIP_START 89 · _FILTER_HOLDER · _MUG_PICKUP&lt;br&gt;_POSITIONING · _POUR_READY · _POURING&lt;br&gt;_RETURNING · _TCP_RESTORE · _MUG_RETURN · _DONE&lt;br&gt;TEST_FINAL_DRIP     progress 89&lt;br&gt;&lt;br&gt;final_drip_stage / final_drip_progress&lt;br&gt;mug TCP 기준 J6 +45° 1회 기울임" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="410" y="430" width="310" height="210" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;screen 8 — COMPLETE&lt;/b&gt;&lt;br&gt;&lt;br&gt;WAIT_NEW_ORDER      progress 100&lt;br&gt;&lt;br&gt;spiral_progress=100 · final_drip_progress=100&lt;br&gt;&apos;커피 주문하기&apos; 버튼(DI 13) 활성&lt;br&gt;buttons.wait_for_button(allowed={13}) — 무기한" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="60" y="430" width="310" height="210" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;screen 9 — ROBOT ERROR&lt;/b&gt;&lt;br&gt;&lt;br&gt;ERROR               progress 0&lt;br&gt;TEST_ERROR          progress 0&lt;br&gt;&lt;br&gt;error = &apos;ExceptionType: message&apos;&lt;br&gt;sleep(1.0) 후 무조건 screen 1 복귀&lt;br&gt;※ 재시도 없음 — 복구 불가 예외 전용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="60" y="730" width="310" height="200" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;screen 10 — GRIP FAILURE RECOVERY&lt;/b&gt;&lt;br&gt;&lt;br&gt;GRIP_FAILURE      recovery_state=WAIT_ADMIN_CALL&lt;br&gt;ADMIN_CALLED      recovery_state=ADMIN_CALLED&lt;br&gt;STAGE_RESTARTING  recovery_state=RESTARTING&lt;br&gt;&lt;br&gt;grip_failure=True · grip_diagnostics{} · failed_stage_*&lt;br&gt;DI 13 관리자 호출 → DI 14 정리완료&lt;br&gt;progress 는 stage_recovery_ui[stage_id] 유지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="410" y="730" width="310" height="200" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;screen 11 — EQUIPMENT ERROR&lt;/b&gt;&lt;br&gt;&lt;br&gt;GRIPPER_SIGNAL_ERROR&lt;br&gt;  WAIT_MOTION_STOP → WAIT_GRIPPER_SIGNAL&lt;br&gt;  → SIGNAL_STABILIZING → WAIT_RESTART_CONFIRMATION&lt;br&gt;  → RESTART_COUNTDOWN (3.0s)&lt;br&gt;STAGE_RESTARTING  recovery_state=RESTARTING&lt;br&gt;&lt;br&gt;equipment_error=True · recovery_countdown_sec&lt;br&gt;DI 13 승인 + 3초 카운트다운" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="760" y="730" width="310" height="200" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;STAGE_RESTARTED (화면 복귀)&lt;/b&gt;&lt;br&gt;&lt;br&gt;screen, progress = stage_recovery_ui[stage_id]&lt;br&gt;&lt;br&gt;  bean_drop    → (2, 10)&lt;br&gt;  grinder      → (4, 42)&lt;br&gt;  dripper_in   → (5, 68)&lt;br&gt;  spiral_pour  → (6, 75)&lt;br&gt;  final_drip   → (7, 89)&lt;br&gt;  gripper_*    → (1, 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;arcSize=8" vertex="1" parent="1"><mxGeometry x="1110" y="730" width="310" height="200" as="geometry"/></mxCell><mxCell id="n15" value="DI 13~16 입력&lt;br&gt;(전체 공정 시작)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#2E7D32;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="bean_drop 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#2E7D32;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="회전수 확정" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#2E7D32;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="grinder 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#2E7D32;strokeWidth=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="dripper_in 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#2E7D32;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="spiral_pour 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#2E7D32;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="final_drip 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#2E7D32;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="DI 13 = 새 주문" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#2E7D32;strokeWidth=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n10" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="웹 /test 단계 테스트&lt;br&gt;(원하는 단계로 직접 진입)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6A1B9A;strokeWidth=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="sleep(1.0) → continue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="n11" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="Exception" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n4" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="DI 14 정리완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="DI 13 + 3초 카운트다운" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="STAGE_RESTARTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6A1B9A;strokeWidth=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=1;entryY=1;" edge="1" parent="1" source="n14" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="GripFailureError" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n6" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="GripperSignalLostError" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;strokeWidth=2;dashed=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="전이 규칙&lt;br&gt;  · 화면 번호는 로봇 노드가 결정한다. 웹은 판단하지 않고 그대로 렌더링한다.&lt;br&gt;    web_ui.js:  n = Math.max(1, Math.min(11, Number(s.screen || 1)))  →  show(n, failed_stage_id)&lt;br&gt;  · 상태 전달 경로 : status.publish() → /coffee_system/status (String JSON, TRANSIENT_LOCAL)&lt;br&gt;                    → CoffeeWebBridge._callback() 이 DEFAULT_STATE 에 dict.update() 병합&lt;br&gt;                    → WS /ws 가 0.2s 주기로 직렬화 비교 후 &apos;변경 시에만&apos; push  (GET /api/state 는 폴백)&lt;br&gt;  · publish 는 부분 payload 병합 방식이라, 한 번 설정된 필드는 명시적으로 덮어쓸 때까지 유지된다.&lt;br&gt;  · screen 10/11 은 role=&quot;alertdialog&quot; 모달로 렌더링되어 진행 화면 위에 덮인다.&lt;br&gt;&lt;br&gt;확인된 이슈&lt;br&gt;  1. screen 10/11 은 progress 를 stage_recovery_ui 값으로 유지하지만 phase 는 복구 상태를 가리켜,&lt;br&gt;     브라우저 상단 phase 배지와 진행 바가 서로 다른 문맥을 표시한다.&lt;br&gt;  2. TEST_DONE 이 screen 1 + progress 100 을 내보내므로, 선택 대기 화면에 진행 바가 100% 로 남는다.&lt;br&gt;  3. DI 13 이 &apos;원두 선택&apos; · &apos;새 주문&apos; · &apos;관리자 호출&apos; · &apos;재시작 승인&apos; 4가지 의미로 재사용된다.&lt;br&gt;     구분은 오직 현재 screen 문맥에만 의존한다.&lt;br&gt;  4. WAITING_CONTROLLER 는 web_ui.py 의 DEFAULT_STATE 에만 존재하고 로봇 노드는 발행하지 않는다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#b5a642;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10" vertex="1" parent="1"><mxGeometry x="60" y="990" width="1360" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>